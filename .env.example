# Local development configuration for SentinelAI
# Copy this file to .env if you want to override defaults locally.

ORDER_SERVICE_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8001
SENTINEL_API_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000
FRONTEND_SENTINEL_API_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set this for hosted PostgreSQL. Leave empty to use the component settings below.
DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=sentinelai

# Optional incident notifications. Leave the URL empty to disable webhooks.
ALERT_WEBHOOK_URL=
ALERT_RECOVERY_ENABLED=false
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
